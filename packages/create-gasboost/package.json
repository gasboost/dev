{
  "name": "create-gasboost",
  "version": "0.1.0",
  "description": "Capability-driven project generator for the Gasboost ecosystem",
  "type": "module",
  "bin": {
    "create-gasboost": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "pnpm test && pnpm test:e2e",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pack:check": "pnpm pack",
    "smoke": "node dist/bin.js --help"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "google-apps-script",
    "gas",
    "scaffolding",
    "generator",
    "firebase",
    "react",
    "gasboost"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gasboost/dev.git",
    "directory": "packages/create-gasboost"
  },
  "homepage": "https://github.com/gasboost/dev"
}
