{
  "name": "@gasboost/fake-node",
  "version": "0.3.0",
  "description": "This package provides a fake implementation of Google Apps Script built-in services for testing purposes.",
  "license": "MIT",
  "author": "tiger-oshima",
  "repository": {
    "type": "git",
    "url": "https://github.com/gasboost/dev.git",
    "directory": "packages/fake-node"
  },
  "type": "commonjs",
  "scripts": {
    "format": "prettier --ignore-path .prettierignore --write .",
    "formatcheck": "prettier --ignore-path .prettierignore --check .",
    "typecheck": "pnpm typecheck:build && pnpm typecheck:test",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "pnpm build && vitest run",
    "check": "pnpm formatcheck && pnpm lint && pnpm typecheck && pnpm test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pack:check": "pnpm pack"
  },
  "dependencies": {
    "@gasboost/fake-core": "workspace:*",
    "date-fns-tz": "^3.2.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/google-apps-script": "^2.0.12",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  }
}
